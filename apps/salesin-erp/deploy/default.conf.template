# Serves the SalesIn SPA and keeps ERPNext same-origin.
#
# Rendered at container start by the nginx image's envsubst step, so the upstream
# can be changed in docker-compose.yml without rebuilding the image:
#   ${ERPNEXT_UPSTREAM}  where /api, /files, /private and /socket.io are forwarded
#   ${ERPNEXT_HOST}      the Host header sent upstream (the ERPNext site name)
#
# Why a proxy at all, instead of letting the browser call ERPNext directly:
#
#   1. erp.hmgtr.com currently returns TWO Access-Control-Allow-Origin headers
#      (ERPNext's own allow_cors plus a hardcoded nginx add_header). The CORS spec
#      allows one, so browsers reject the response as invalid CORS.
#   2. ERPNext's `sid` cookie is `SameSite=Lax`, and browsers never attach a Lax
#      cookie to a cross-site fetch, so the request would arrive unauthenticated
#      however CORS is configured.
#
# Proxying removes both: the browser only ever talks to the app's own origin.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 32m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # --- SPA client-side routing ------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- ERPNext, forwarded so the app stays same-origin ------------------
    # proxy_pass WITHOUT a URI keeps the original path intact
    # (/api/method/x stays /api/method/x).
    #
    # Host must be the ERPNext site name: Frappe decides which site to serve from
    # the Host header, so forwarding app.hmgtr.com would return "site not found".
    location ~ ^/(api|files|private|socket\.io)(/|$) {
        proxy_pass ${ERPNEXT_UPSTREAM};

        proxy_set_header Host ${ERPNEXT_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Only used when the upstream is https://; ignored for plain http.
        proxy_ssl_server_name on;
        proxy_ssl_name ${ERPNEXT_HOST};

        # socket.io uses this same block; harmless for ordinary requests.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;

        # ERPNext sets `sid` host-only, so the browser stores it for the app's own
        # origin and nothing needs rewriting. Uncomment if your site is configured
        # with an explicit cookie domain:
        # proxy_cookie_domain erp.hmgtr.com app.hmgtr.com;
    }

    # No CORS headers belong here. Same-origin needs none, and adding them is what
    # produced the duplicate-header bug on erp.hmgtr.com.
}
